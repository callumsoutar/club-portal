# Copy this file to .env.local and fill in values from your SafetyHub Supabase project.
# The homepage and briefing-room TV read published rows from public.safety_messages.

# Project URL from the Supabase dashboard Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe to expose in the browser.
# Do not use a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required for flight authorisation writes (submissions, approvals,
# notifications). Never prefix this with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=

# Absolute URL used in flight notification links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend. Leave the API key unset in development — notifications are logged, not sent.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=FlightAuth <dispatch@example.com>
